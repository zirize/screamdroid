    <string name="preset_balanced">Balanced</string>
    <string name="preset_stable">Stable</string>
    <string name="settings_buffer_floor">On this device it rises to %1$d–%2$d ms — the buffer
        inside the audio device will not go below that.</string>
    <string name="settings_applies_now">Changes apply straight away — no need to stop and
        start.</string>

