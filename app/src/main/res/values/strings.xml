    <string name="app_name">Screamdroid</string>

    <!-- ── First-run guide ────────────────────────────────────────── -->
    <string name="guide_title">Before you start</string>
    <string name="guide_intro">This phone plays what the PC sends it. Three things to do once, and one worth knowing.</string>
    <string name="guide_battery_title">Set battery use to unrestricted</string>
    <string name="guide_battery_body">Otherwise the phone is free to freeze this app once the screen has been off for a few minutes. Audio then stops arriving and does not come back until the phone is unlocked - a foreground service does not prevent it.</string>
    <string name="guide_battery_done">Done - battery use is unrestricted.</string>
    <string name="guide_address_title">Write this address on the PC</string>
    <string name="guide_address_body">The sender has to be pointed at this phone: put this into the ip and port of scream-sender.conf. A wrong octet looks exactly like a quiet PC from here.</string>
    <string name="guide_tile_title">Add the quick settings tile</string>
    <string name="guide_tile_body">Android does not let this app start itself after a reboot, so the tile is how it is switched on without hunting for the app.</string>
    <string name="guide_icon_title">Getting rid of the status bar icon</string>
    <string name="guide_icon_body">The app cannot remove it - the system promotes the notification whatever the app asks for. Remove it from the phone\'s own status bar icon list instead: the notification and its three buttons stay.</string>
    <string name="guide_reopen_note">This is in Settings whenever you want it again.</string>
    <string name="guide_start">Start</string>
    <string name="settings_show_guide">Show the first-run guide</string>
