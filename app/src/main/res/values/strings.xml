    <string name="settings_group_power">Power and starting</string>
    <string name="settings_save_battery">Save battery while silent</string>
    <string name="settings_save_battery_note">On battery, the audio engine is stopped once
        everything goes quiet. Short sounds - a click, a chime - then arrive about a tenth of a
        second late, because the engine has to start again first. While charging it is always
        kept running.</string>
    <string name="settings_low_latency_wifi">Low-latency Wi-Fi</string>
    <string name="settings_low_latency_wifi_note">Stops the radio batching packets. Costs
        battery, and is handed back by itself after ten quiet minutes. Android applies it only
        while the screen is on, so with the screen off the buffer is what carries you.</string>
    <string name="settings_allow_mobile">Receive on mobile data</string>
    <string name="settings_allow_mobile_note">The sender is normally on the same network, so this
        is off by default.</string>
    <string name="settings_start_on_boot">Start on boot</string>
    <string name="settings_start_on_boot_why">Android does not let a media playback service start
        at boot. Use the quick settings tile instead.</string>
    <string name="settings_not_possible">Not possible</string>
    <string name="settings_add_tile">Add the quick settings tile</string>
    <string name="settings_add_tile_manually">Open quick settings, tap the edit (pencil) button,
        and drag Screamdroid into the panel.</string>

