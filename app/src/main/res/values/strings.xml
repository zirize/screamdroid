    <!-- ── Call screen ────────────────────────────────────────────── -->
    <string name="call_banner_title">On a call — muted automatically</string>
    <string name="call_banner_body">It comes back by itself when the call ends. Nothing to
        do.</string>
    <string name="mute_banner_title">Muted by hand</string>
    <string name="mute_banner_body">Unmuting picks up live: nothing is queued while it is
        off.</string>
    <string name="call_preview_title">Preview</string>
    <string name="call_preview_body">Nothing is muted right now. Call detection arrives with the
        next step; muting by hand already works exactly like this.</string>
    <string name="call_discard_title">Still receiving, and throwing it away</string>
    <string name="call_discard_body">Simply stopping would pile a three-minute call up in the
        buffer, and hanging up would play audio from three minutes ago. So it is discarded as it
        arrives, and the buffer is emptied before it fills again.</string>
    <string name="call_discarded">discarded %1$s</string>
    <string name="call_elapsed">for %1$s</string>
    <string name="call_footer">Settings → Calls and alerts chooses between mute, quieten and
        ignore.</string>

    <!-- ── Settings ───────────────────────────────────────────────── -->
    <string name="settings_group_receiving">Receiving</string>
    <string name="settings_port_invalid">%1$d–%2$d</string>
    <string name="settings_multicast_port">Group port</string>
    <string name="settings_unicast">Also receive unicast</string>
    <string name="settings_unicast_note">Packets aimed at this phone\'s own address. Turn it off
        where that address is not the one the sender has.</string>
    <string name="settings_unicast_port">Unicast port</string>
    <string name="settings_receiving_note">The group is always listened for, and it is what keeps
        working when this phone moves to another network — it is addressed to the group rather
        than to this phone. Wi-Fi carries group traffic at its slowest rate and some routers drop
        it, which is what unicast is for. If both arrive at once the group is heard; the two
        cannot be blended into one another, because the PC is what mixes.</string>
    <string name="settings_group_address">Group address</string>
    <string name="settings_group_invalid">224.0.0.0 – 239.255.255.255</string>

